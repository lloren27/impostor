# Redis exclusivo para pruebas de integración.
# NO usar las credenciales de producción.
#
# IMPORTANTE: @upstash/redis conecta mediante la API REST de Upstash,
# no el protocolo Redis nativo. Un servidor Redis local (brew install redis)
# NO funciona directamente sin un proxy compatible con la API REST de Upstash.
#
# Opción recomendada: crear una base de datos separada en Upstash para pruebas.
#   1. Ir a https://upstash.com y crear una base de datos nueva (gratuita).
#   2. Copiar las credenciales REST_URL y REST_TOKEN.
#   3. Copiar este archivo a .env.test y rellenar las líneas de abajo.
#
# Alternativa: usar upstash-local (proxy REST compatible) si se prefiere Redis local:
#   npm install -g @upstash/local
#   upstash-local
#   UPSTASH_REDIS_REST_URL=http://localhost:8079
#   UPSTASH_REDIS_REST_TOKEN=dummy-token

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
