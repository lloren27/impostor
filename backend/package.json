{
  "name": "impostor-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "test:security": "ts-node src/__tests__/security.test.ts",
    "test:atomicity": "ts-node src/__tests__/atomicity.test.ts",
    "test:sprint2": "ts-node src/__tests__/sprint2.test.ts",
    "test:sprint3": "ts-node src/__tests__/sprint3.test.ts",
    "test:sprint4": "ts-node src/__tests__/sprint4.test.ts",
    "test:regressions": "npm run test:security && npm run test:atomicity && npm run test:sprint2 && npm run test:sprint3 && npm run test:sprint4"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.8",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.1",
    "eslint": "^10.15.0",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
